				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Encoder = {}

function Encoder.Color3(value: Color3): string
	return `{math.round(value.R * 255)}, {math.round(value.G * 255)}, {math.round(value.B * 255)}`
end

function Encoder.number(value: number): string
	return tostring(value)
end

function Encoder.boolean(value: boolean): string
	return value and `true` or `false`
end

return Encoder]]></ProtectedString>
					<string name="ScriptGuid">{f0be251c-79c8-c7bd-80d8-5c14b47a4556}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">Encoder</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX627AA923F2144D71829B0BB70D4525E4">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Decoder = {}

function Decoder.Color3(value: string): Color3
	return Color3.fromRGB(unpack(value:split(`, `)))
end

function Decoder.number(value: string): number
	return tonumber(value)
end

function Decoder.boolean(value: string): number
	return value == `true` and true or false
end

return Decoder]]></ProtectedString>
